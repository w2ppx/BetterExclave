+package observatory
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/exclavenetwork/exclave-core/v5/common/net"
+	"github.com/exclavenetwork/exclave-core/v5/features/outbound"
+	"github.com/exclavenetwork/exclave-core/v5/transport/internet/tagged"
+)
+
+func TestGetObservationIsRaceFreeSnapshot(t *testing.T) {
+	o := &Observer{config: &Config{}, ctx: context.Background()}
+
+	var wg sync.WaitGroup
+	stop := make(chan struct{})
+	for w := 0; w < 4; w++ {
+		wg.Add(1)
+		go func(w int) {
+			defer wg.Done()
+			for i := 0; ; i++ {
+				select {
+				case <-stop:
+					return
+				default:
+				}
+				o.updateStatusForResult(fmt.Sprintf("out-%d", (w*7+i)%16), &ProbeResult{Alive: i%2 == 0, Delay: int64(i)})
+			}
+		}(w)
+	}
+	for i := 0; i < 2000; i++ {
+		msg, err := o.GetObservation(context.Background())
+		if err != nil {
+			t.Fatal(err)
+		}
+		for _, s := range msg.(*ObservationResult).Status {
+			_ = s.Alive
+			_ = s.Delay
+			_ = s.OutboundTag
+			_ = s.LastErrorReason
+		}
+	}
+	close(stop)
+	wg.Wait()
+
+	// mutating the returned snapshot must not touch the observer's state
+	o.updateStatusForResult("x", &ProbeResult{Alive: true, Delay: 5})
+	snap, _ := o.GetObservation(context.Background())
+	for _, s := range snap.(*ObservationResult).Status {
+		s.Alive = false
+		s.Delay = -1
+	}
+	again, _ := o.GetObservation(context.Background())
+	for _, s := range again.(*ObservationResult).Status {
+		if s.OutboundTag == "x" && (!s.Alive || s.Delay != 5) {
+			t.Fatalf("observer state was changed through a snapshot: %+v", s)
+		}
+	}
+}
+
+type staticSelector struct {
+	outbound.Manager
+	tags []string
+}
+
+func (s *staticSelector) Select([]string) []string { return s.tags }
+
+// With EnableConcurrency=false the outbounds must be probed one at a time, each probe
+// followed by ProbeInterval, without an extra concurrent burst of probes afterwards.
+func TestSequentialProbingDoesNotFallThroughToConcurrent(t *testing.T) {
+	const interval = 40 * time.Millisecond
+
+	var mu sync.Mutex
+	var starts []time.Time
+	var inflight, maxInflight int32
+	oldDialer := tagged.Dialer
+	tagged.Dialer = func(ctx context.Context, dest net.Destination, tag string) (net.Conn, error) {
+		n := atomic.AddInt32(&inflight, 1)
+		defer atomic.AddInt32(&inflight, -1)
+		for {
+			m := atomic.LoadInt32(&maxInflight)
+			if n <= m || atomic.CompareAndSwapInt32(&maxInflight, m, n) {
+				break
+			}
+		}
+		mu.Lock()
+		starts = append(starts, time.Now())
+		mu.Unlock()
+		time.Sleep(2 * time.Millisecond)
+		return nil, errors.New("test dialer")
+	}
+	defer func() { tagged.Dialer = oldDialer }()
+
+	o := &Observer{
+		config: &Config{
+			SubjectSelector:   []string{"o"},
+			ProbeUrl:          "http://probe.invalid/",
+			ProbeInterval:     int64(interval),
+			EnableConcurrency: false,
+		},
+		ctx: context.Background(),
+		ohm: &staticSelector{tags: []string{"o1", "o2", "o3"}},
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() { o.background(ctx); close(done) }()
+	time.Sleep(interval*8 + interval/2)
+	cancel()
+	<-done
+
+	mu.Lock()
+	defer mu.Unlock()
+	if len(starts) < 4 {
+		t.Fatalf("only %d probes ran", len(starts))
+	}
+	if m := atomic.LoadInt32(&maxInflight); m != 1 {
+		t.Errorf("%d probes ran at once in sequential mode", m)
+	}
+	for i := 1; i < len(starts); i++ {
+		if gap := starts[i].Sub(starts[i-1]); gap < interval/2 {
+			t.Errorf("probe %d started %v after the previous one, want about %v", i, gap, interval)
+		}
+	}
+	if len(o.status) != 3 {
+		t.Errorf("status has %d entries, want 3", len(o.status))
+	}
+}
