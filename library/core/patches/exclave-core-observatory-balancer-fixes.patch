+package outbound_test
+
+import (
+	"context"
+	"reflect"
+	"testing"
+
+	. "github.com/exclavenetwork/exclave-core/v5/app/proxyman/outbound"
+	"github.com/exclavenetwork/exclave-core/v5/transport"
+)
+
+type taggedHandler string
+
+func (h taggedHandler) Start() error                              { return nil }
+func (h taggedHandler) Close() error                              { return nil }
+func (h taggedHandler) Tag() string                               { return string(h) }
+func (h taggedHandler) Dispatch(context.Context, *transport.Link) {}
+
+func TestSelectOrdersBySelectorThenTag(t *testing.T) {
+	m, err := New(context.Background(), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, tag := range []string{"proxy-b", "backup", "proxy-a", "direct", "proxy-c", "backup-2"} {
+		if err := m.AddHandler(context.Background(), taggedHandler(tag)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	want := []string{"backup", "backup-2", "proxy-a", "proxy-b", "proxy-c"}
+	// selector order wins over tag order; within one selector the tags are sorted
+	for i := 0; i < 50; i++ { // map iteration order is randomised, so repeat
+		if got := m.Select([]string{"backup", "proxy"}); !reflect.DeepEqual(got, want) {
+			t.Fatalf("Select() = %v, want %v", got, want)
+		}
+	}
+	// a tag matching several selectors is ranked by the first one and listed once
+	if got := m.Select([]string{"proxy-c", "proxy"}); !reflect.DeepEqual(got, []string{"proxy-c", "proxy-a", "proxy-b"}) {
+		t.Fatalf("Select() = %v", got)
+	}
+}
