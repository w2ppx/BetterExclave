+	"github.com/exclavenetwork/exclave-core/v5/features/outbound"
+)
+
+type fakeObservatory struct {
+	mu    sync.Mutex
+	alive map[string]bool
+}
+
+func (f *fakeObservatory) Type() interface{} { return extension.ObservatoryType() }
+func (f *fakeObservatory) Start() error      { return nil }
+func (f *fakeObservatory) Close() error      { return nil }
+
+func (f *fakeObservatory) set(tag string, alive bool) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	f.alive[tag] = alive
+}
+
+func (f *fakeObservatory) GetObservation(context.Context) (proto.Message, error) {
+	f.mu.Lock()
+	defer f.mu.Unlock()
+	result := &observatory.ObservationResult{}
+	for tag, alive := range f.alive {
+		result.Status = append(result.Status, &observatory.OutboundStatus{OutboundTag: tag, Alive: alive})
+	}
+	return result, nil
+}
+
+// fakeManager selects from a fixed, already ordered list of tags.
+type fakeManager struct {
+	outbound.Manager
+	tags []string
+}
+
+func (m *fakeManager) Select(selectors []string) []string {
+	var out []string
+	for _, tag := range m.tags {
+		for _, s := range selectors {
+			if strings.HasPrefix(tag, s) {
+				out = append(out, tag)
+				break
+			}
+		}
+	}
+	return out
+}
+
+func TestFallbackStrategyPicksFirstAliveInOrder(t *testing.T) {
+	obs := &fakeObservatory{alive: map[string]bool{"a": true, "b": true, "c": true}}
+	s := &FallbackStrategy{observatory: obs, config: &StrategyFallbackConfig{}}
+
+	cases := []struct {
+		dead []string
+		want string
+	}{
+		{nil, "a"},
+		{[]string{"a"}, "b"},
+		{[]string{"a", "b"}, "c"},
+		{[]string{"a", "b", "c"}, ""},
+	}
+	for _, c := range cases {
+		for _, tag := range []string{"a", "b", "c"} {
+			obs.set(tag, true)
+		}
+		for _, tag := range c.dead {
+			obs.set(tag, false)
+		}
+		if got := s.PickOutbound([]string{"a", "b", "c"}); got != c.want {
+			t.Errorf("dead=%v: PickOutbound() = %q, want %q", c.dead, got, c.want)
+		}
+	}
+	// an outbound the observatory has not reported yet is not considered alive
+	obs.set("b", true)
+	if got := s.PickOutbound([]string{"unknown", "b"}); got != "b" {
+		t.Errorf("PickOutbound() = %q, want b", got)
+	}
+}
+
+func TestFallbackBalancerUsesFallbackTag(t *testing.T) {
+	rule := &BalancingRule{
+		Tag:              "balancer",
+		OutboundSelector: []string{"primary"},
+		Strategy:         "fallback",
+		StrategySettings: serial.ToTypedMessage(&StrategyFallbackConfig{ObserverTag: "observer"}),
+		FallbackTag:      "backup",
+	}
+	ohm := &fakeManager{tags: []string{"primary-1", "primary-2", "backup"}}
+	b, err := rule.Build(ohm, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if b.fallbackTag != "backup" {
+		t.Fatalf("fallbackTag = %q, want backup", b.fallbackTag)
+	}
+	obs := &fakeObservatory{alive: map[string]bool{"primary-1": false, "primary-2": true, "backup": true}}
+	b.strategy.(*FallbackStrategy).observatory = obs
+
+	if tag, err := b.PickOutbound(); err != nil || tag != "primary-2" {
+		t.Fatalf("PickOutbound() = %q, %v; want primary-2", tag, err)
+	}
+	obs.set("primary-2", false)
+	// every selected outbound is dead: the balancer must use fallbackTag, not candidates[0]
+	if tag, err := b.PickOutbound(); err != nil || tag != "backup" {
+		t.Fatalf("PickOutbound() = %q, %v; want backup", tag, err)
+	}
+	obs.set("primary-1", true)
+	if tag, err := b.PickOutbound(); err != nil || tag != "primary-1" {
+		t.Fatalf("PickOutbound() = %q, %v; want primary-1", tag, err)
+	}
+}
+
+func TestFallbackTagWiredForEveryStrategy(t *testing.T) {
+	settings := map[string]proto.Message{
+		"fallback":  &StrategyFallbackConfig{},
+		"leastping": &StrategyLeastPingConfig{},
+		"leastload": &StrategyLeastLoadConfig{},
+		"random":    &StrategyRandomConfig{},
+	}
+	for strategy, s := range settings {
+		rule := &BalancingRule{
+			OutboundSelector: []string{"p"},
+			Strategy:         strategy,
+			StrategySettings: serial.ToTypedMessage(s),
+			FallbackTag:      "backup",
+		}
+		b, err := rule.Build(&fakeManager{}, nil)
+		if err != nil {
+			t.Fatalf("%s: %v", strategy, err)
+		}
+		if b.fallbackTag != "backup" {
+			t.Errorf("%s: fallbackTag = %q, want backup", strategy, b.fallbackTag)
+		}
+	}
+}
